# 1. Indicamos al servidor cuál es el archivo principal que debe abrir
DirectoryIndex index.html

# 2. Desactivamos el listado automático de carpetas (evita Error 403)
Options -Indexes

# 3. Proteger archivos sensibles de accesos directos HTTP
<FilesMatch "\.(env|sqlite|db|json|sql|log)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# 4. Habilitar Reescritura de URLs y Atajos Cortos (mod_rewrite)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forzar HTTPS en todo el sitio
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Atajos cortos (Shortcuts directos)
    RewriteRule ^como-llegar/?$ es/como-llegar.html [R=301,L]
    RewriteRule ^how-to-get-here/?$ en/como-llegar.html [R=301,L]
    RewriteRule ^anreise/?$ de/como-llegar.html [R=301,L]

    RewriteRule ^checkin/?$ es/checkin-autonomo.html [R=301,L]
    RewriteRule ^checkin-es/?$ es/checkin-autonomo.html [R=301,L]
    RewriteRule ^checkin-en/?$ en/checkin-autonomo.html [R=301,L]
    RewriteRule ^checkin-de/?$ de/checkin-autonomo.html [R=301,L]

    # Cargar archivos .html automáticamente sin escribir .html
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>
